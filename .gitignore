# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (skill scripts)
__pycache__/
*.pyc

# Supabase CLI scratch state, not project config
supabase/.temp/

# Skills d'agent installés via `npx skills add`.
# Outillage, pas code produit : ils se réinstallent d'une commande, et les
# versionner ici mettrait cinquante dossiers tiers dans chaque diff du site.
# Retirez ces deux lignes si vous voulez au contraire les figer pour l'équipe.
# Seulement la partie tierce : les skills se réinstallent d'une commande, et
# les versionner mettrait cinquante dossiers externes dans chaque diff du
# site. Ce que VOUS écrivez dans .agents/ reste suivi — c'est votre contexte
# de marque, il a plus de valeur que le code qui l'utilise.
.agents/skills/
.claude/skills/
# Sauf celui-ci, déjà versionné avant l'arrivée des autres et propre au projet.
!.claude/skills/ui-ux-pro-max/
